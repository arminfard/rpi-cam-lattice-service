[Unit]
Description=MediaMTX SRT Push Server (Raspberry Pi Camera)
# Start after the Lattice service so the SRT target (written by it from the
# VideoManager ingress URL) exists. The camera can only be opened by one
# process at a time — stop the sibling rtsp-server / mpeg-ts-server units first.
After=network-online.target rpi-cam-lattice-service.service
Wants=network-online.target rpi-cam-lattice-service.service

[Service]
Type=simple
WorkingDirectory=/home/airhead/workspace/rpi-cam-lattice-service
# The SRT push destination (srt://...) written by rpi-cam-lattice-service as
# SRT_TARGET=<url>. Keep this path in sync with SRT_TARGET_FILE in .env.
EnvironmentFile=/home/airhead/workspace/rpi-cam-lattice-service/srt_target.env
ExecStart=/home/airhead/workspace/rpi-cam-lattice-service/mediamtx /home/airhead/workspace/rpi-cam-lattice-service/mediamtx.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
